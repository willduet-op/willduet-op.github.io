---
import BaseLayout from "../../layouts/BaseLayout.astro";import AcademyHeader from "../../components/AcademyHeader.astro";import AcademyFooter from "../../components/AcademyFooter.astro";import Breadcrumbs from "../../components/Breadcrumbs.astro";import AcademyLeadForm from "../../components/AcademyLeadForm.astro";import { academyWhatsAppUrl } from "../../config/academy";import "../../styles/academy.css";
const items=[{label:"Inicio",href:"/"},{label:"Academy",href:"/academy/"},{label:"Contacto",href:"/academy/contacto/"}];
const structuredData=[{"@context":"https://schema.org","@type":"ContactPage",name:"Contacto WILLDUET Academy",url:"https://willduet.com/academy/contacto/"},{"@context":"https://schema.org","@type":"BreadcrumbList",itemListElement:items.map((item,index)=>({"@type":"ListItem",position:index+1,name:item.label,item:`https://willduet.com${item.href}`}))}];
---
<BaseLayout title="Orientación para estudiar Análisis de Datos | WILLDUET Academy" description="Cuéntanos tu experiencia y recibe orientación sobre nuestros cursos de Excel, SQL y Power BI para prepararte como Analista de Datos." canonicalPath="/academy/contacto/" lang="es" structuredData={structuredData} bodyClass="academy-body" preloadImage=""><AcademyHeader/><main class="academy-main"><section class="academy-content-hero"><div class="academy-container"><Breadcrumbs items={items}/><span class="academy-kicker">Encuentra tu punto de partida</span><h1>Empieza tu ruta hacia el análisis de datos</h1><p>Cuéntanos qué experiencia tienes y qué quieres lograr. Te orientaremos sobre el curso que mejor se ajusta a las habilidades que necesitas desarrollar para avanzar hacia un rol de Analista de Datos.</p><a class="academy-btn academy-btn-primary" href={academyWhatsAppUrl()} target="_blank" rel="noopener" data-meta-whatsapp data-meta-contact data-meta-location="contact_page">Hablar por WhatsApp</a></div></section><section class="academy-section"><div class="academy-container academy-two-col"><div><h2>¿Prefieres que te contactemos?</h2><p>Completa tus datos, selecciona el curso que te interesa y te contactaremos con información sobre la próxima cohorte.</p></div><div class="academy-card academy-form-card"><AcademyLeadForm includeMessage={true}/></div></div></section></main><AcademyFooter/></BaseLayout>
