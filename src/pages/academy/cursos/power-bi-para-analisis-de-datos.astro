---
import CoursePage from "../../../components/CoursePage.astro";import { courses } from "../../../config/academy";
const base=courses[2];const course={...base,longDescription:"Aprende Power BI para desempeñarte como Analista de Datos: transforma información, construye modelos y KPIs, y presenta dashboards que faciliten decisiones de negocio.",metaDescription:"Curso virtual de Power BI para Analistas de Datos en RD. Aprende Power Query, modelado, DAX, KPIs y dashboards con un proyecto de portafolio."};
const audience=["Personas con conocimientos básicos de Excel que quieren avanzar hacia Business Intelligence.","Profesionales que necesitan analizar y presentar información para tomar decisiones.","Personas que quieren iniciar o fortalecer una carrera como Analista de Datos.","Estudiantes que desean crear un proyecto de Power BI para su portafolio."];
const outcomes=["Comprender cómo desarrolla una solución de Power BI un Analista de Datos.","Transformar y modelar datos correctamente.","Crear medidas y KPIs alineados con objetivos del negocio.","Diseñar dashboards claros que faciliten decisiones.","Publicar un proyecto que demuestre tus habilidades."];
const modules=[{title:"Módulo 1",items:["Rol del analista de datos","Estructura de solución BI"]},{title:"Módulo 2",items:["Conexión a fuentes de datos","Excel","CSV","Bases de datos","Carpetas"]},{title:"Módulo 3",items:["Limpieza y transformación con Power Query"]},{title:"Módulo 4",items:["Modelado de datos","Relaciones"]},{title:"Módulo 5",items:["Medidas","DAX","Creación de KPIs"]},{title:"Módulo 6",items:["Visualización","Dashboards","Publicación en Power BI Service"]},{title:"Bloque adicional",items:["CV","Portafolio","Búsqueda de empleo","Proyecto final"]}];
const includes=["Certificado","Proyecto guiado para portafolio"];
const process=["Datos → transformación → modelado","Crear métricas y KPIs","Visualizar y publicar información","Resolver preguntas de negocio","Trabajar con datasets realistas","Crear entregables profesionales","Desarrollar proyectos para portafolio"];
---
<CoursePage course={course} audience={audience} outcomes={outcomes} modules={modules} includes={includes} process={process}/>
