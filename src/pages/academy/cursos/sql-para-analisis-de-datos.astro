---
import CoursePage from "../../../components/CoursePage.astro";import { courses } from "../../../config/academy";
const base=courses[1];const course={...base,longDescription:"Aprende SQL específicamente para el trabajo de un Analista de Datos: consulta y combina información, valida resultados y convierte preguntas de negocio en análisis reproducibles.",metaDescription:"Curso virtual de SQL para Analistas de Datos en RD. Aprende consultas, JOINs, CTEs y funciones de ventana resolviendo casos de negocio."};
const audience=["Personas que quieren aprender SQL para convertirse en Analistas de Datos.","Profesionales que necesitan consultar información sin depender de reportes manuales.","Personas que buscan cambiar de carrera hacia el análisis de datos.","Estudiantes que desean desarrollar una habilidad solicitada en empleos de datos."];
const outcomes=["Comprender cómo utiliza SQL un Analista de Datos.","Consultar, filtrar y agrupar información de bases de datos.","Combinar tablas evitando duplicados y resultados incorrectos.","Traducir preguntas de negocio en consultas y análisis para tu portafolio."];
const modules=[{title:"Fundamentos",items:["SQL Server","Bases relacionales","Llaves","Cardinalidades","Modelo estrella"]},{title:"Consultas",items:["SELECT","WHERE","ORDER BY","Filtros","Tipos de datos","NULL"]},{title:"Análisis",items:["Funciones de agregación","GROUP BY","HAVING","CASE WHEN","Fechas","Texto"]},{title:"Combinación de datos",items:["JOINs","Relaciones","Anti-JOINs","Detección de duplicados","Fan-out"]},{title:"SQL intermedio / avanzado",items:["Subqueries","CTEs","Funciones de ventana","Rankings","Acumulados"]},{title:"Aplicación",items:["Responder preguntas de negocio","Vistas","Indicadores","Power BI","Proyecto final"]}];
const includes=["Certificado","Materiales","Grabaciones"];
const process=["Resolver preguntas de negocio","Trabajar con datasets realistas","Pensar como analista","Entender métricas y KPIs","Crear entregables profesionales","Desarrollar proyectos para portafolio","Comprender cómo se relacionan Excel, SQL y Power BI"];
---
<CoursePage course={course} audience={audience} outcomes={outcomes} modules={modules} includes={includes} process={process}/>
