---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import AcademyHeader from "../../../components/AcademyHeader.astro";
import AcademyFooter from "../../../components/AcademyFooter.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import { academyArticles } from "../../../config/academyBlog";
import "../../../styles/academy.css";
import "../../../styles/academy-blog.css";
const items=[{label:"Inicio",href:"/"},{label:"Academy",href:"/academy/"},{label:"Blog",href:"/academy/blog/"}];
const structuredData=[
  {"@context":"https://schema.org","@type":"CollectionPage",name:"Blog de análisis de datos",url:"https://willduet.com/academy/blog/",description:"Guías prácticas para aprender análisis de datos y prepararte para trabajar en el área."},
  {"@context":"https://schema.org","@type":"BreadcrumbList",itemListElement:items.map((item,index)=>({"@type":"ListItem",position:index+1,name:item.label,item:`https://willduet.com${item.href}`}))}
];
---
<BaseLayout title="Blog de análisis de datos | WILLDUET Academy" description="Guías prácticas para aprender análisis de datos, desarrollar habilidades profesionales y prepararte para buscar empleo en el área." canonicalPath="/academy/blog/" lang="es" structuredData={structuredData} bodyClass="academy-body" preloadImage="/academia/academy-hero.webp">
  <AcademyHeader />
  <main class="academy-main academy-blog-main">
    <section class="academy-blog-index-hero"><div class="academy-container"><Breadcrumbs items={items}/><span class="academy-kicker">Recursos para tu carrera</span><h1>Blog de análisis de datos</h1><p>Guías claras para entender el trabajo de un analista, aprender las herramientas con propósito y construir una ruta realista hacia tu primera oportunidad.</p></div></section>
    <section class="academy-section"><div class="academy-container"><div class="academy-blog-grid">{academyArticles.map(article => <article class="academy-blog-card"><a class="academy-blog-card-image" href={`/academy/blog/${article.slug}/`}><img src={article.image} alt={article.imageAlt} width="1774" height="887" loading="eager" decoding="async" /></a><div><span class="academy-kicker">{article.category}</span><h2><a href={`/academy/blog/${article.slug}/`}>{article.title}</a></h2><p>{article.description}</p><div class="academy-blog-card-meta"><time datetime={article.datePublished}>{article.dateLabel}</time><span>{article.readingTime}</span></div><a class="academy-blog-read" href={`/academy/blog/${article.slug}/`} aria-label={`Leer ${article.title}`}>Leer guía <span aria-hidden="true">→</span></a></div></article>)}</div></div></section>
  </main>
  <AcademyFooter />
</BaseLayout>
