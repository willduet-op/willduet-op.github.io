<BaseLayout title={title} description={description} canonicalPath="/terms-and-conditions/" lang="en" preloadImage=""><Header/><main class="legal-main"><div class="legal-shell"><header class="legal-header"><h1>Terms &amp; Conditions</h1><p class="legal-updated">Last Updated: September 2026</p></header><nav class="legal-toc" aria-label="Table of contents"><strong>Contents</strong><ol>{sections.map(section=><li><a href={`#${id(section)}`}>{section}</a></li>)}</ol></nav><div class="legal-content">
