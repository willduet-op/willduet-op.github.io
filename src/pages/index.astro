---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/brand-home.css";
const structuredData = { "@context": "https://schema.org", "@type": "Organization", name: "WILLDUET", url: "https://willduet.com/", logo: "https://willduet.com/logo-willduet-sin-fondo.png" };
---
<BaseLayout title="WILLDUET | Data Consulting y Academy" description="WILLDUET reúne soluciones de tecnología y datos para organizaciones y formación práctica para carreras en análisis de datos." canonicalPath="/" structuredData={structuredData} bodyClass="brand-body" preloadImage="">
  <main class="brand-home">
    <header class="brand-intro"><div class="brand-mark"><img src="/logo-willduet-sin-fondo.png" alt="" width="44" height="44" /><strong>WILLDUET</strong></div><p>Tecnología, datos y desarrollo profesional para organizaciones y personas.</p></header>
    <div class="brand-divisions">
      <section class="brand-division"><div class="brand-division-inner"><span class="brand-label">DATA CONSULTING</span><h1>Modern data solutions for organizations</h1><p>Modern data infrastructure, analytics engineering and business intelligence solutions for organizations.</p><div class="brand-capabilities"><span>Data Engineering</span><span>Analytics Engineering</span><span>Business Intelligence</span><span>Data Warehouses</span><span>Data Lakes</span><span>Data Pipelines</span><span>Cloud Data Platforms</span><span>Reporting &amp; Analytics</span></div><a class="btn btn-primary" href="/consulting/">Explore Data Consulting</a></div></section>
      <section class="brand-division brand-academy" lang="es"><div class="brand-division-inner"><span class="brand-label">WILLDUET ACADEMY</span><h2>Formación práctica en análisis de datos</h2><p>Formación práctica para personas que quieren desarrollar habilidades aplicables a una carrera en análisis de datos.</p><div class="brand-capabilities"><span>Excel</span><span>SQL</span><span>Power BI</span><span>Análisis de Datos</span><span>Proyectos prácticos</span><span>Preparación laboral</span></div><a class="btn btn-primary" href="/academy/">Explorar la Academia</a></div></section>
    </div>
  </main>
</BaseLayout>
