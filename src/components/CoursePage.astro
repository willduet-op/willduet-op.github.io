---
import BaseLayout from "../layouts/BaseLayout.astro";
import AcademyHeader from "./AcademyHeader.astro";
import AcademyFooter from "./AcademyFooter.astro";
import Breadcrumbs from "./Breadcrumbs.astro";
import AcademyLeadForm from "./AcademyLeadForm.astro";
import AcademyFAQ from "./AcademyFAQ.astro";
import { academyWhatsAppUrl, courses } from "../config/academy";
import "../styles/academy.css";

const { course, audience, outcomes, modules, includes, process } = Astro.props;
const whatsappUrl = academyWhatsAppUrl(course.message);
const canonicalPath = `/academy/cursos/${course.slug}/`;
const breadcrumbItems = [
  { label: "Inicio", href: "/" },
  { label: "Academy", href: "/academy/" },
  { label: "Cursos", href: "/academy/cursos/" },
  { label: course.name, href: canonicalPath },
];
const structuredData = [
  {
    "@context": "https://schema.org", "@type": "Course", name: course.name,
    description: course.longDescription, url: `https://willduet.com${canonicalPath}`,
    provider: { "@type": "EducationalOrganization", name: "WILLDUET Academy", url: "https://willduet.com/academy/" },
    offers: { "@type": "Offer", price: course.price.replace(/[^0-9]/g, ""), priceCurrency: "DOP", availability: "https://schema.org/InStock", url: `https://willduet.com${canonicalPath}` },
    courseMode: "Online",
  },
  {
    "@context": "https://schema.org", "@type": "BreadcrumbList",
    itemListElement: breadcrumbItems.map((item, index) => ({ "@type": "ListItem", position: index + 1, name: item.label, item: `https://willduet.com${item.href}` })),
  },
];
const relatedCourses = courses.filter(item => item.slug !== course.slug);
---
<BaseLayout title={`${course.name} | WILLDUET Academy`} description={course.metaDescription} canonicalPath={canonicalPath} lang="es" structuredData={structuredData} bodyClass="academy-body" preloadImage={course.heroImage}>
  <AcademyHeader />
  <main class="academy-main">
    <section class="academy-course-hero academy-course-detail-hero"><div class="academy-container"><Breadcrumbs items={breadcrumbItems} /><div class="academy-hero-grid"><div><span class="academy-kicker">Curso en vivo · República Dominicana</span><h1>{course.name}</h1><p class="academy-lead">{course.longDescription}</p><div class="academy-actions"><a class="academy-btn academy-btn-primary" href={whatsappUrl} target="_blank" rel="noopener" data-meta-whatsapp data-meta-course-name={course.name} data-meta-course-slug={course.slug} data-meta-location="hero">Quiero más información</a><a class="academy-btn academy-btn-ghost" href="#contenido">Ver contenido</a></div></div><div class="academy-media academy-hero-media"><img src={course.heroImage} alt={course.heroAlt} width="1774" height="887" loading="eager" decoding="async" fetchpriority="high" /></div></div></div></section>

    <section class="academy-quick"><div class="academy-container academy-quick-grid"><div><span>Modalidad</span><strong>Virtual con clases en vivo</strong></div><div><span>Inversión</span><strong>{course.price}</strong><small>Facilidades de pago disponibles</small></div><div><span>Disponibilidad</span><strong>Consulta la próxima fecha</strong></div></div></section>

    <section class="academy-section"><div class="academy-container academy-two-col"><div><span class="academy-kicker">Para quién</span><h2>¿A quién va dirigido?</h2></div><ul class="academy-check-list">{audience.map(item => <li>{item}</li>)}</ul></div></section>

    <section class="academy-section academy-section-soft"><div class="academy-container"><div class="academy-section-heading"><span class="academy-kicker">Resultados de aprendizaje</span><h2>¿Qué aprenderás?</h2></div><div class="academy-feature-grid">{outcomes.map(item => <article class="academy-card"><span aria-hidden="true">✓</span><p>{item}</p></article>)}</div></div></section>

    <section class="academy-section" id="contenido"><div class="academy-container"><div class="academy-section-heading"><span class="academy-kicker">Programa</span><h2>Contenido del curso</h2></div><div class="academy-module-grid">{modules.map(module => <article class="academy-card academy-module"><h3>{module.title}</h3><ul>{module.items.map(item => <li>{item}</li>)}</ul></article>)}</div></div></section>

    <section class="academy-section academy-section-soft"><div class="academy-container academy-project-grid"><div class="academy-media academy-project-media"><img src={course.projectImage} alt={course.projectAlt} width="1774" height="887" loading="lazy" decoding="async" /></div><div><span class="academy-kicker">Evidencia de tus habilidades</span><h2>Construye un proyecto para tu portafolio</h2><p>Integra lo aprendido en un caso práctico que te ayude a explicar cómo abordas un problema, analizas información y presentas resultados.</p><dl class="academy-project-meta"><div><dt>Enfoque</dt><dd>Una pregunta o necesidad realista de negocio</dd></div><div><dt>Proceso</dt><dd>Preparación, análisis, validación y comunicación</dd></div><div><dt>Resultado</dt><dd>Un entregable que puedas presentar y explicar</dd></div></dl></div></div></section>

    <section class="academy-section"><div class="academy-container academy-work-section"><div><span class="academy-kicker">Preparación para el rol</span><h2>Aprende la herramienta como la usaría un Analista de Datos</h2><p>No se trata solo de completar ejercicios técnicos. La metodología conecta cada función con preguntas, métricas, decisiones y entregables propios del trabajo de análisis de datos.</p></div><ul class="academy-check-list">{process.map(item => <li>{item}</li>)}</ul></div></section>

    <section class="academy-section academy-section-soft"><div class="academy-container academy-two-col"><div><span class="academy-kicker">Incluido</span><h2>Lo que incluye</h2></div><ul class="academy-check-list">{includes.map(item => <li>{item}</li>)}</ul></div></section>

    <section class="academy-section"><div class="academy-container academy-investment"><div><span class="academy-kicker">Inversión</span><h2>{course.price}</h2><p><strong>Facilidades de pago disponibles.</strong> Consulta por WhatsApp la próxima fecha, las opciones de pago y los pasos de inscripción.</p><a class="academy-btn academy-btn-primary" href={whatsappUrl} target="_blank" rel="noopener" data-meta-whatsapp data-meta-course-name={course.name} data-meta-course-slug={course.slug} data-meta-location="pricing">Quiero más información</a></div><div class="academy-card academy-form-card"><h2>¿Prefieres que te contactemos?</h2><p>Déjanos tus datos y el curso que te interesa.</p><AcademyLeadForm selectedCourse={course.name} /></div></div></section>

    <section class="academy-section academy-section-soft"><div class="academy-container"><div class="academy-section-heading"><span class="academy-kicker">Preguntas frecuentes</span><h2>FAQ</h2></div><AcademyFAQ /></div></section>

    <section class="academy-section"><div class="academy-container"><div class="academy-section-heading"><h2>También puedes explorar</h2></div><div class="academy-related">{relatedCourses.map(item => <a class="academy-card" href={`/academy/cursos/${item.slug}/`} data-meta-course-name={item.name} data-meta-course-slug={item.slug} data-meta-location="related_courses"><strong>{item.name}</strong><span>Ver curso →</span></a>)}</div></div></section>

    <section class="academy-final-cta"><div class="academy-container"><h2>Da el próximo paso hacia una carrera como Analista de Datos</h2><p>Conoce la próxima cohorte y descubre si este curso corresponde a tu punto de partida.</p><a class="academy-btn academy-btn-primary" href={whatsappUrl} target="_blank" rel="noopener" data-meta-whatsapp data-meta-course-name={course.name} data-meta-course-slug={course.slug} data-meta-location="final_cta">Quiero más información</a></div></section>
  </main>
  <AcademyFooter />
  <a class="academy-mobile-sticky" href={whatsappUrl} target="_blank" rel="noopener" data-meta-whatsapp data-meta-course-name={course.name} data-meta-course-slug={course.slug} data-meta-location="sticky_mobile">Solicitar información por WhatsApp</a>
</BaseLayout>
