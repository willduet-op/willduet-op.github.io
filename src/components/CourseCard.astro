---
const { course } = Astro.props;
---
<article class="academy-card course-card">
  <div class={`course-visual course-visual-${course.slug.split("-")[0]}`}>
    <img src={course.heroImage} alt={course.heroAlt} width="1774" height="887" loading="lazy" decoding="async" />
  </div>
  <div class="course-card-body"><h3>{course.name}</h3><p>{course.description}</p><strong class="course-price">{course.price}</strong><a class="academy-btn academy-btn-secondary" href={`/academy/cursos/${course.slug}/`} data-meta-course-name={course.name} data-meta-course-slug={course.slug} data-meta-location="course_card">Ver curso</a></div>
</article>
