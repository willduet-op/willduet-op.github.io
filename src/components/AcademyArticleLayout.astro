---
import BaseLayout from "../layouts/BaseLayout.astro";
import AcademyHeader from "./AcademyHeader.astro";
import AcademyFooter from "./AcademyFooter.astro";
import Breadcrumbs from "./Breadcrumbs.astro";
import "../styles/academy.css";
import "../styles/academy-blog.css";

const { title, description, canonicalPath, article, structuredData } = Astro.props;
const items = [
  { label: "Inicio", href: "/" },
  { label: "Academy", href: "/academy/" },
  { label: "Blog", href: "/academy/blog/" },
  { label: article.title, href: canonicalPath },
];
---
<BaseLayout title={title} description={description} canonicalPath={canonicalPath} image={article.image} preloadImage={article.image} lang="es" structuredData={structuredData} bodyClass="academy-body">
  <AcademyHeader />
  <main class="academy-main academy-blog-main">
    <header class="academy-article-hero">
      <div class="academy-container">
        <Breadcrumbs items={items} />
        <div class="academy-article-hero-grid">
          <div>
            <span class="academy-kicker">{article.category}</span>
            <h1>{article.title}</h1>
            <p class="academy-article-deck">{article.description}</p>
            <div class="academy-article-meta">
              <span>Por WILLDUET Academy</span>
              <time datetime={article.datePublished}>Publicado el {article.dateLabel}</time>
              <span>{article.readingTime}</span>
            </div>
          </div>
          <img src={article.image} alt={article.imageAlt} width="1774" height="887" loading="eager" decoding="async" />
        </div>
      </div>
    </header>
    <article class="academy-article">
      <slot />
    </article>
  </main>
  <AcademyFooter />
</BaseLayout>
