---
import { academyWhatsAppUrl, courses } from "../config/academy";
import AcademyMetaTracking from "./AcademyMetaTracking.astro";
const infoUrl = academyWhatsAppUrl();
const nav = [
  ["/academy/", "Inicio"],
  ["/academy/sobre-nosotros/", "Sobre Nosotros"],
  ["/academy/cursos/", "Cursos"],
  ["/academy/contacto/", "Contacto"],
];
---
<header class="academy-header">
  <div class="academy-container academy-nav-wrap">
    <a class="academy-logo" href="/academy/" aria-label="WILLDUET Academy, inicio">
      <img src="/logo-willduet-sin-fondo.png" alt="" width="36" height="36" />
      <span><strong>WILLDUET</strong><small>Academy</small></span>
    </a>
    <nav class="academy-nav" aria-label="Navegación de Academy">
      {nav.map(([href, label]) => label === "Cursos" ? (
        <div class="academy-nav-dropdown">
          <a href={href} aria-haspopup="true">Cursos <span aria-hidden="true">⌄</span></a>
          <div class="academy-nav-dropdown-menu">
            {courses.map((course) => (
              <a href={`/academy/cursos/${course.slug}/`} data-meta-course-name={course.name} data-meta-course-slug={course.slug} data-meta-location="navbar_dropdown">{course.name}</a>
            ))}
          </div>
        </div>
      ) : <a href={href}>{label}</a>)}
    </nav>
    <div class="academy-nav-actions">
      <a class="academy-division-link" href="/consulting/">Data Consulting</a>
      <a class="academy-btn academy-btn-primary" href={infoUrl} target="_blank" rel="noopener" data-meta-whatsapp data-meta-contact data-meta-location="navbar">Solicitar información</a>
    </div>
    <details class="academy-mobile-menu">
      <summary aria-label="Abrir navegación">Menú</summary>
      <nav>{nav.map(([href, label]) => <a href={href}>{label}</a>)}{courses.map((course) => <a class="academy-mobile-course" href={`/academy/cursos/${course.slug}/`} data-meta-course-name={course.name} data-meta-course-slug={course.slug} data-meta-location="navbar_dropdown">{course.name}</a>)}<a href="/consulting/">Data Consulting</a><a href={infoUrl} target="_blank" rel="noopener" data-meta-whatsapp data-meta-contact data-meta-location="navbar">Solicitar información</a></nav>
    </details>
  </div>
</header>
<AcademyMetaTracking />

<style>
  .academy-nav-dropdown { position: relative; display: flex; align-items: center; }
  .academy-nav-dropdown > a { display: flex; align-items: center; gap: 5px; }
  .academy-nav-dropdown > a span { font-size: 15px; transition: transform 160ms ease; }
  .academy-nav-dropdown-menu {
    position: absolute;
    top: 100%;
    left: 0;
    width: 310px;
    padding: 9px;
    border: 1px solid var(--academy-line);
    border-radius: 15px;
    background: #fff;
    box-shadow: 0 18px 45px rgba(16, 34, 60, .16);
    opacity: 0;
    visibility: hidden;
    transform: translateY(6px);
    transition: opacity 160ms ease, transform 160ms ease, visibility 160ms ease;
  }
  .academy-nav-dropdown-menu a { display: block; padding: 11px 12px; border-radius: 9px; line-height: 1.35; }
  .academy-nav-dropdown-menu a:hover,
  .academy-nav-dropdown-menu a:focus-visible { background: var(--academy-paper); }
  .academy-nav-dropdown:hover .academy-nav-dropdown-menu,
  .academy-nav-dropdown:focus-within .academy-nav-dropdown-menu { opacity: 1; visibility: visible; transform: translateY(0); }
  .academy-nav-dropdown:hover > a span,
  .academy-nav-dropdown:focus-within > a span { transform: rotate(180deg); }
  .academy-mobile-course { padding-left: 24px !important; font-size: 13px; color: var(--academy-muted) !important; }
</style>
